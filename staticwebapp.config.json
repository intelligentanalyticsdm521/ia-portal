{
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": ["/assets/*", "/*.{css,scss,png,jpg,jpeg,gif,svg,webp,ico}"]
  },
  "responseOverrides": {
    "404": {
      "rewrite": "/index.html"
    }
  },
  "routes": [
    {
      "route": "/welcome*",
      "headers": {
        "Referrer-Policy": "no-referrer"
      }
    }
  ]
}
