# =============================================================
# Portal — HESTIA Phase 2 local verification mode
#
# Run with:  npm run dev -- --mode hestia2 --port 5175
#
# Deliberately a MODE file rather than .env.local, so it cannot affect the
# dev-stack portal already running on its own port with its own config.
#
# Every URL here is loopback. VITE_FORGE_API_BASE_URL points at the Phase 2
# forge-api started against the LOCAL Docker SQL container — never at the
# forge-api on :8091, which is configured for production Azure SQL.
# =============================================================

VITE_DEV_AUTH=1
VITE_DEV_TENANT=a0000001-0000-0000-0000-000000000001

VITE_PLATFORM_API_BASE_URL=http://localhost:4000
VITE_LUMEN_API_BASE_URL=http://localhost:4001
VITE_ARION_API_BASE_URL=http://localhost:4003
VITE_FORGE_API_BASE_URL=http://localhost:8199

VITE_DEFAULT_TENANT_ID=a0000001-0000-0000-0000-000000000001
VITE_DEFAULT_PORTAL_CONTEXT=business
VITE_FORGE_CATALOG_URL=https://intelligentanalyticsdm.com/forge

# MSAL must be able to construct even though dev-auth means it is never used:
# main.tsx refuses to boot without these. No sign-in happens in this mode —
# useAccessToken returns the dev stand-in and never calls MSAL.
VITE_AUTH_CLIENT_ID=5d836399-27a2-4d2c-99f7-b7d0b4f39ac2
VITE_AUTH_AUTHORITY=https://iadmexternalid.ciamlogin.com/8c9527b9-8999-4b31-a306-f3d4ccc39fbd
VITE_AUTH_KNOWN_AUTHORITIES=iadmexternalid.ciamlogin.com
VITE_AUTH_REDIRECT_URI=http://localhost:5175/auth/callback
VITE_AUTH_POST_LOGOUT_REDIRECT_URI=http://localhost:5175/
VITE_AUTH_SCOPES=openid,profile,email,api://08ba6bdd-4090-4083-9986-9f13181f066f/access_as_user

# Phase 2 (fundraising/acknowledgements/reporting) is built and tested but its
# API is not in production. On locally, off everywhere else.
VITE_FORGE_HESTIA_PHASE2=1
