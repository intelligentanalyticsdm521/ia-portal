# =============================
# IADM Portal v1 (Vite/React)
# =============================

# platform-api base URL (NO trailing slash)
VITE_PLATFORM_API_BASE_URL=https://api-platform-iadm-prod.azurewebsites.net

# Entra External ID (CIAM) - Portal SPA app registration (Client ID)
VITE_AUTH_CLIENT_ID=REPLACE_WITH_PORTAL_SPA_CLIENT_ID

# Authority used by MSAL.
# Use the authority/tenant you have configured in External ID (CIAM).
# Example from your tenant:
#   https://iadmexternalid.ciamlogin.com/8c9527b9-8999-4b31-a306-f3d4ccc39fbd
VITE_AUTH_AUTHORITY=https://iadmexternalid.ciamlogin.com/8c9527b9-8999-4b31-a306-f3d4ccc39fbd

# Known authorities (comma-separated) to prevent authority spoofing.
# Example:
#   iadmexternalid.ciamlogin.com
VITE_AUTH_KNOWN_AUTHORITIES=iadmexternalid.ciamlogin.com

# Redirect URI registered in the portal app registration.
# Default if omitted: <origin>/auth/callback
# VITE_AUTH_REDIRECT_URI=http://localhost:5173/auth/callback

# Logout redirect.
# Default if omitted: <origin>/
# VITE_AUTH_POST_LOGOUT_REDIRECT_URI=http://localhost:5173/

# Scopes requested by MSAL (comma-separated).
# IMPORTANT: To call platform-api, this must produce a token whose `aud` matches
# core.tenant_auth_providers.audience for the tenant.
# Example:
#   api://<PLATFORM_API_APP_ID>/access_as_user,openid,profile,email
VITE_AUTH_SCOPES=REPLACE_WITH_SCOPES

# Default tenant for initial testing (you can override in the header at runtime)
VITE_DEFAULT_TENANT_ID=8c9527b9-8999-4b31-a306-f3d4ccc39fbd

# Optional: set default portal context (customer|employee). Default is customer.
VITE_DEFAULT_PORTAL_CONTEXT=customer

# Optional: enabled service keys for v1 navigation (comma-separated).
# platform-api v1 does not expose tenant service entitlements, so v1 uses this
# to mark services as enabled.
# Example:
#   lumen_crm,stella_bi
VITE_ENABLED_SERVICES=
